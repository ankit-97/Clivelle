# Copy to .env locally. Never commit real credentials.
NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:4173,http://localhost:5173,http://127.0.0.1:4173,http://127.0.0.1:5500
TRUST_PROXY=0

# SQL Server / Azure SQL
# Use windows for local Windows integrated authentication, or sql for SQL username/password.
DB_AUTH=windows
DB_SERVER=localhost
DB_PORT=1433
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_NAME=Clivelle
DB_USER=sa
DB_PASSWORD=change-me
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=15000

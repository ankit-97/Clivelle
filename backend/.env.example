# Copy to .env locally. Never commit real credentials.
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:5500,capacitor://localhost,https://ankit-97.github.io
TRUST_PROXY=0

# PostgreSQL is the production path on Render. When DATABASE_URL exists,
# backend/src/start.js starts the persistent PostgreSQL API.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PGSSL=require
DB_POOL_MAX=10

# SQL Server fallback for the original local development backend.
# Leave DATABASE_URL unset to use this path.
DB_AUTH=windows
DB_SERVER=localhost
DB_PORT=1433
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_NAME=Clivelle
DB_USER=sa
DB_PASSWORD=change-me
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=15000

# Optional OTP provider configuration (not required for password signup/signin).
OTP_TWILIO_ACCOUNT_SID=
OTP_TWILIO_AUTH_TOKEN=
OTP_TWILIO_VERIFY_SERVICE_SID=
OTP_SENDGRID_API_KEY=
OTP_EMAIL_FROM=
